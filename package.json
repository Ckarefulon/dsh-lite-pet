{
  "name": "dsh-lite-pet",
  "version": "0.2.6",
  "description": "轻量系统级桌宠：原生进程逐像素透明渲染，工作正文/等待确认/完成提示与余额查询联动，点击穿透",
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "cordis"
  ],
  "homepage": "https://github.com/Ckarefulon/dsh-lite-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ckarefulon/dsh-lite-pet.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "assets/icon.png",
    "runtime/pet/DshLitePet.exe",
    "runtime/pet/libwebp.dll",
    "runtime/pet/libwebpdemux.dll",
    "runtime/pet/libsharpyuv.dll",
    "runtime/media",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-media.mjs && node tools/build-pet.mjs",
    "build:media": "node tools/build-media.mjs",
    "build:media:full": "node tools/build-media.mjs --tier full --out runtime/media-full && node tools/pack-media.mjs",
    "build:pet": "node tools/build-pet.mjs",
    "test:pet": "node tools/smoke-pet.mjs",
    "test:zip": "node tools/zip-selftest.mjs",
    "test:ambient": "node tools/ambient-selftest.mjs",
    "test:playback": "node tools/playback-selftest.mjs",
    "prepack": "node tools/prepack-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "license": "MIT"
}
